<odoo>
    <record id="sequence_template_backend_theme" model="sequence.template">
        <field name="name">Standard</field>
        <field name="model_id" ref="model_backend_theme" />
        <field name="sequence" eval="100" />
        <field name="initial_string">/</field>
        <field
            name="sequence_field_id"
            search="[('model_id.model','=','backend_theme'),('name','=','code')]"
        />
        <!-- backend_theme is master data and has no dedicated date field;
             create_date (always present) is used to satisfy the
             mandatory date_field_id. -->
        <field
            name="date_field_id"
            search="[('model_id.model','=','backend_theme'),('name','=','create_date')]"
        />
        <field name="computation_method">use_python</field>
        <field name="python_code">result=True</field>
        <field name="sequence_id" ref="sequence_backend_theme" />
        <field name="sequence_selection_method">use_sequence</field>
        <field name="add_custom_prefix" eval="0" />
        <field name="add_custom_suffix" eval="0" />
    </record>
</odoo>
