<odoo>
    <!-- Every internal user has full CRUD on the model itself; the
         accompanying ir.rule (security/ir_rule/backend_theme_bookmark.xml)
         is what actually restricts each user to their own bookmarks. No
         dedicated group; see the design note in models/
         backend_theme_bookmark.py. -->
    <record id="backend_theme_bookmark_all_access" model="ir.model.access">
        <field name="name">backend_theme_bookmark - all</field>
        <field name="model_id" ref="model_backend_theme_bookmark" />
        <field name="group_id" ref="base.group_user" />
        <field name="perm_read" eval="1" />
        <field name="perm_write" eval="1" />
        <field name="perm_create" eval="1" />
        <field name="perm_unlink" eval="1" />
    </record>
</odoo>
