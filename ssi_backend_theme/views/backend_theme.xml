<odoo>
    <record id="backend_theme_view_search" model="ir.ui.view">
        <field name="name">backend_theme - search</field>
        <field name="model">backend_theme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//group[@name='dom_active']" position="after">
                    <group>
                        <filter
                            name="grp_sidebar_default"
                            string="Default Sidebar State"
                            context="{'group_by':'sidebar_default'}"
                        />
                        <filter
                            name="grp_color_scheme_default"
                            string="Default Color Scheme"
                            context="{'group_by':'color_scheme_default'}"
                        />
                    </group>
                </xpath>
            </data>
        </field>
    </record>

    <record id="backend_theme_view_list" model="ir.ui.view">
        <field name="name">backend_theme - list</field>
        <field name="model">backend_theme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_tree"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="color_primary" optional="show" />
                    <field name="font_family" optional="hide" />
                    <field name="sidebar_default" optional="hide" />
                    <field name="color_scheme_default" optional="hide" />
                </xpath>
            </data>
        </field>
    </record>

    <record id="backend_theme_view_form" model="ir.ui.view">
        <field name="name">backend_theme - form</field>
        <field name="model">backend_theme</field>
        <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_form"
        />
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//notebook/page[@name='note']" position="before">
                    <page name="colors" string="Colors">
                        <group name="colors_group_1" string="Brand Colors">
                            <field name="color_primary" />
                            <field name="color_navbar_bg" />
                            <field name="color_navbar_text" />
                            <field name="color_text_body" />
                            <field name="color_view_background" />
                        </group>
                        <group name="colors_group_2" string="Status Colors">
                            <field name="color_success" />
                            <field name="color_info" />
                            <field name="color_warning" />
                            <field name="color_danger" />
                        </group>
                        <group name="colors_group_3" string="List View Colors">
                            <field name="color_list_header_bg" />
                            <field name="color_list_row_hover_bg" />
                        </group>
                    </page>
                    <page name="typography" string="Typography">
                        <group name="typography_group_1" string="Font">
                            <field name="font_family" />
                            <field name="font_size_base" />
                        </group>
                        <group name="typography_group_2" string="Spacing">
                            <field name="paragraph_spacing" />
                            <field name="form_spacing" />
                        </group>
                    </page>
                    <page name="navbar" string="Navbar">
                        <group name="navbar_group_1" string="Navbar Sizing">
                            <field name="navbar_height" />
                            <field name="navbar_font_size" />
                        </group>
                        <group name="navbar_group_2" string="Navbar Entry Spacing">
                            <field name="navbar_entry_padding_h" />
                            <field name="navbar_entry_margin_h" />
                            <field name="navbar_entry_border_radius" />
                        </group>
                    </page>
                    <page name="defaults" string="Defaults">
                        <group name="defaults_group_1" string="Layout Defaults">
                            <field name="sidebar_default" />
                            <field name="color_scheme_default" />
                            <field name="app_submenu_position" />
                        </group>
                        <group name="defaults_group_2" string="Sidebar Visibility">
                            <field name="show_sidebar" />
                            <field name="show_sidebar_logo" />
                            <field name="show_sidebar_recent" />
                            <field name="show_sidebar_bookmarks" />
                            <field name="group_apps_by_category" />
                        </group>
                        <group name="defaults_group_3" string="Chatter">
                            <field name="chatter_position" />
                            <field name="show_chatter_toggle" />
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

    <record id="backend_theme_action" model="ir.actions.act_window">
        <field name="name">Backend Theme</field>
        <field name="res_model">backend_theme</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_backend_theme"
        action="backend_theme_action"
        parent="menu_backend_theme_root"
    />
</odoo>
