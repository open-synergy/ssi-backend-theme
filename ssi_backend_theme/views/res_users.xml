<odoo>
    <record id="view_users_form_simple_modif_backend_theme" model="ir.ui.view">
        <field name="name">res.users.preferences.form - ssi_backend_theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="backend_theme_color_scheme" />
            </xpath>
        </field>
    </record>
</odoo>
