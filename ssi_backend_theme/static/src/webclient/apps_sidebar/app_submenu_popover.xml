<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ssi_backend_theme.AppSubmenuPopover">
        <div class="o_ssi_app_submenu_popover">
            <ul class="list-unstyled mb-0">
                <t t-foreach="props.sections" t-as="section" t-key="section.id">
                    <li
                        class="o_ssi_app_submenu_popover_section text-truncate"
                        t-att-data-menu-xmlid="section.xmlid"
                        t-on-click="() => this.onSectionClick(section)"
                    >
                        <t t-esc="section.name" />
                    </li>
                </t>
            </ul>
        </div>
    </t>

</templates>
