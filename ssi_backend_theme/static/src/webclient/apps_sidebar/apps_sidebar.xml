<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ssi_backend_theme.AppsSidebar">
        <aside
            class="o_ssi_apps_sidebar d-flex flex-column flex-nowrap d-print-none"
            t-att-class="{o_ssi_apps_sidebar_collapsed: state.collapsed}"
        >
            <a
                t-if="showLogo"
                href="/odoo"
                class="o_ssi_apps_sidebar_logo d-flex align-items-center flex-shrink-0"
                t-att-aria-label="companyName"
                t-att-title="companyName"
            >
                <img
                    t-if="state.hasCompanyLogo"
                    class="o_ssi_apps_sidebar_logo_img"
                    t-attf-src="{{companyLogoUrl}}"
                    alt=""
                />
            </a>
            <div
                class="o_ssi_apps_sidebar_toggle d-flex align-items-center justify-content-end flex-shrink-0"
            >
                <button
                    class="btn btn-sm bg-transparent border-0"
                    t-att-aria-label="toggleLabel"
                    t-att-title="toggleLabel"
                    t-on-click="toggle"
                >
                    <i
                        class="oi"
                        t-att-class="state.collapsed ? 'oi-chevron-right' : 'oi-chevron-left'"
                        aria-hidden="true"
                    />
                </button>
            </div>
            <ul
                class="o_ssi_apps_sidebar_apps list-unstyled flex-shrink-0 overflow-auto mb-0"
            >
                <!-- One shape covers both the flat and the grouped-by-category
                     (issue #18) rendering: `sidebarRows` (apps_sidebar.esm.js)
                     only ever emits "title" rows while grouping is active. -->
                <t t-foreach="sidebarRows" t-as="row" t-key="row.key">
                    <li
                        t-if="row.type === 'title'"
                        class="o_ssi_apps_sidebar_group_title text-truncate"
                        t-esc="row.label"
                    />
                    <li
                        t-else=""
                        class="o_ssi_apps_sidebar_app"
                        t-att-class="{'bg-primary-subtle': isCurrentApp(row.app)}"
                        t-att-data-menu-xmlid="row.app.xmlid"
                    >
                        <a
                            t-att-href="getMenuItemHref(row.app)"
                            t-att-title="row.app.name"
                            class="d-flex align-items-center"
                            t-on-click.prevent="(ev) => this.onAppClick(row.app, ev)"
                        >
                            <img
                                t-if="row.app.webIconData"
                                class="o_ssi_apps_sidebar_app_icon flex-shrink-0"
                                t-attf-src="{{row.app.webIconData}}"
                                alt=""
                            />
                            <span
                                class="o_ssi_apps_sidebar_app_name text-truncate"
                                t-esc="row.app.name"
                            />
                        </a>
                    </li>
                </t>
            </ul>
            <!-- Inline "sidebar" submenu (issue #17): the current app's own
                 sections, only in "sidebar" mode (never alongside "navbar"
                 or "popover" — see `showInlineSubmenu`, apps_sidebar.esm.js). -->
            <t t-if="showInlineSubmenu">
                <hr class="my-1 flex-shrink-0" />
                <ul
                    class="o_ssi_apps_sidebar_sections list-unstyled flex-grow-1 overflow-auto mb-0"
                >
                    <t t-foreach="currentAppSections" t-as="section" t-key="section.id">
                        <li
                            class="o_ssi_apps_sidebar_section text-truncate"
                            t-att-data-menu-xmlid="section.xmlid"
                            t-on-click="() => this.onSectionClick(section)"
                        >
                            <t t-esc="section.name" />
                        </li>
                    </t>
                </ul>
            </t>
            <!-- RECENT/BOOKMARKS panel (issue #13): only while expanded;
                 fully absent from the DOM, not just visually hidden, when
                 collapsed. Also fully absent (issue #16) when the active
                 theme has both show_sidebar_recent and
                 show_sidebar_bookmarks turned off. -->
            <SidebarFooter t-if="!state.collapsed and showFooter" />
        </aside>
    </t>

</templates>
