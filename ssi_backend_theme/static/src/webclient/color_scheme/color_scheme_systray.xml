<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="ssi_backend_theme.ColorSchemeSystrayItem">
        <div class="o_ssi_color_scheme_systray d-flex align-items-center">
            <button
                class="btn btn-sm bg-transparent border-0"
                t-att-aria-label="label"
                t-att-title="label"
                t-on-click="onClick"
            >
                <i
                    class="fa"
                    t-att-class="isDark ? 'fa-sun-o' : 'fa-moon-o'"
                    aria-hidden="true"
                />
            </button>
        </div>
    </t>

</templates>
